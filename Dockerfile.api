# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy solution and project files first for layer caching
COPY InvestmentApp.sln ./
COPY src/InvestmentApp.Api/InvestmentApp.Api.csproj src/InvestmentApp.Api/
COPY src/InvestmentApp.Application/InvestmentApp.Application.csproj src/InvestmentApp.Application/
COPY src/InvestmentApp.Domain/InvestmentApp.Domain.csproj src/InvestmentApp.Domain/
COPY src/InvestmentApp.Infrastructure/InvestmentApp.Infrastructure.csproj src/InvestmentApp.Infrastructure/

RUN dotnet restore src/InvestmentApp.Api/InvestmentApp.Api.csproj

# Copy source and publish. APP_VERSION (git short SHA from Cloud Build) is baked into the assembly
# InformationalVersion so AiAgentController.DocVersion — and thus the /ai/agent/doc ETag — changes every
# deploy. Without this the ETag is a constant "1.0.0" and agent clients (NPU) keep getting 304 with a stale doc.
ARG APP_VERSION=dev
COPY src/ src/
RUN dotnet publish src/InvestmentApp.Api/InvestmentApp.Api.csproj \
    -c Release \
    -o /app/publish \
    --no-restore \
    -p:InformationalVersion=$APP_VERSION

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app

# Create non-root user for security
RUN adduser --disabled-password --gecos "" appuser && chown -R appuser /app
USER appuser

COPY --from=build --chown=appuser:appuser /app/publish ./

ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "InvestmentApp.Api.dll"]
